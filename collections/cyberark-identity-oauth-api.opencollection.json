{
  "opencollection": "1.0.0",
  "info": {
    "name": "CyberArk Identity REST Authentication OAuth API",
    "version": "2026-05"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OAuth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Issue an OAuth 2.0 token for a registered OAuth app",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.id.cyberark.cloud/OAuth2/Token/:appId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                },
                {
                  "name": "username",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                },
                {
                  "name": "code",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Issue an OAuth 2.0 token for a registered OAuth app"
        }
      ]
    }
  ],
  "bundled": true
}