          "name": "Begin an interactive authentication session",
          "request": {
            "name": "Begin an interactive authentication session",
            "description": {
              "content": "Starts an authentication session for a user identified by username\nand tenant. Returns the available authentication mechanisms; the\nclient must complete the flow with /Security/AdvanceAuthentication\nwithin five minutes.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Security",
                "StartAuthentication"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your CyberArk Identity tenant prefix.",
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"User\": \"<string>\",\n  \"Version\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
